# =============================================================================
# MYConnect Analytics — .gitignore
# Portfolio / data-engineering repository intended for GitHub.
#
# Principle: keep ALL source, SQLX/Dataform definitions, documentation, and
# configuration tracked. Exclude only secrets, machine-local artifacts, and
# regenerable bulk data that would break the push.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT  (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template

secrets/
.secrets/
secrets.yaml
secrets.yml
secrets.json
local.settings.json

# -----------------------------------------------------------------------------
# 2. GCP / CLOUD CREDENTIALS
# Targeted filenames only — a blanket *.json would wrongly exclude
# dataform/dataform.json and dataform/package.json.
# -----------------------------------------------------------------------------
*service-account*.json
*service_account*.json
*-sa.json
*credentials*.json
*client_secret*.json
*-key.json
*_key.json
gcp-key*.json
gcloud-key*.json
application_default_credentials.json
adc.json

# Dataform local credentials (created by `dataform init-creds`)
.df-credentials.json
df-credentials.json

# AWS / Azure local config
.aws/
.azure/

# -----------------------------------------------------------------------------
# 3. PRIVATE KEYS & CERTIFICATES
# -----------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.der
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

