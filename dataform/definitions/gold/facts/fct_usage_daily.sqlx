config {
  type: "incremental",
  schema: "myconnect_gold",
  uniqueKey: ["subscription_id", "usage_date"],
  description: "Usage facts with total volume and plan-relative speed achievement. Grain: 1 row per subscription per day."
}

SELECT
  u.usage_id,
  u.subscription_id,
  u.usage_date,
  u.download_gb,
  u.upload_gb,
  (u.download_gb + u.upload_gb) AS total_gb,
  u.peak_download_mbps AS peak_speed,
  u.avg_download_mbps AS avg_speed,
  -- Speed Achievement % (KPI Dictionary Section 14): avg_download_mbps / plan_speed_mbps x 100.
  -- Uses the same usage -> stg_subscriptions -> stg_plans relationship already established for
  -- the plan_speed x 1.5 outlier correction in stg_usage_daily; no flat Mbps cap is reintroduced.
  CASE
    WHEN p.speed_mbps IS NOT NULL AND p.speed_mbps != 0
    THEN ROUND((u.avg_download_mbps / p.speed_mbps) * 100, 2)
    ELSE NULL
  END AS speed_achievement_pct,
  u.created_at
FROM
  ${ref("stg_usage_daily")} u
LEFT JOIN
  ${ref("stg_subscriptions")} s
  ON u.subscription_id = s.subscription_id
LEFT JOIN
  ${ref("stg_plans")} p
  ON s.plan_id = p.plan_id
${when(incremental(), `WHERE u.created_at > (SELECT MAX(created_at) FROM ${self()}) - INTERVAL 3 DAY`)}
